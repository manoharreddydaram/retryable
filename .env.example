# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the blanks.  .env is gitignored.
# ---------------------------------------------------------------------------

# Database
DATABASE_URL=postgresql+psycopg://retryable:retryable@localhost:5432/retryable

# Razorpay -- TEST MODE ONLY. Key id must begin with rzp_test_
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# LLM (used from Stage 7 onward)
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Safety limits. Enforced by the deterministic policy engine (Stage 4).
# These are declared here on day zero so that what this system refuses to do
# is visible before any of its code is read.
# ---------------------------------------------------------------------------

# Global halt. When true, no intervention is dispatched under any circumstance.
KILL_SWITCH_ENABLED=false

# Ceiling on interventions dispatched in a single evaluation run.
MAX_INTERVENTIONS_PER_BATCH=200

# A single payer may not be contacted more than this many times in 7 days.
MAX_TOUCHES_PER_PAYER_7D=3

# No customer outreach outside these hours (24h clock, merchant local time).
QUIET_HOURS_START=21
QUIET_HOURS_END=9

# Diagnoses below this confidence are routed to a human, never acted on.
MIN_DIAGNOSIS_CONFIDENCE=0.7

# Recovery attempts above this amount require human approval. Integer paise.
HUMAN_APPROVAL_THRESHOLD_PAISE=2500000

# Assumed cost of one outreach attempt, used to compute net recovery. Paise.
INTERVENTION_COST_PAISE=50

# ---------------------------------------------------------------------------
# Execution (Stage 5). Razorpay's Payment Links API has no native
# idempotency-key header (only Payouts/Transfers/Refunds do) -- these
# thresholds govern the outbox dispatcher's own retry and circuit-breaker
# behaviour around that gap.
# ---------------------------------------------------------------------------

# Consecutive Razorpay call failures before the circuit breaker opens.
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# How long the breaker stays open before allowing one trial call through.
CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
